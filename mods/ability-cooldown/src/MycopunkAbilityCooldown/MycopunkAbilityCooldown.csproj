<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common settings, references and the deploy step: Directory.Build.props / .targets at the root. -->

  <PropertyGroup>
    <AssemblyName>MycopunkAbilityCooldown</AssemblyName>
    <RootNamespace>MycopunkAbilityCooldown</RootNamespace>
    <Version>0.2.2</Version>
    <!-- MODS tab in the options window; also brings in TextMeshPro and UnityEngine.UI. -->
    <UseSharedMenu>true</UseSharedMenu>
  </PropertyGroup>

  <ItemGroup>
    <!-- TextAnchor, for the layout group of the corner tags. -->
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

</Project>
