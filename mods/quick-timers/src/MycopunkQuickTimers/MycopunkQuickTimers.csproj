<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common settings, references and the deploy step: Directory.Build.props / .targets at the root. -->

  <PropertyGroup>
    <AssemblyName>MycopunkQuickTimers</AssemblyName>
    <RootNamespace>MycopunkQuickTimers</RootNamespace>
    <Version>0.1.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- StartMenu's logo fields are UnityEngine.UI.Graphic; needed to name them with nameof. -->
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

</Project>
